# ==========================================
# NERA ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# OPTION 1: FIREBASE (Authentication & Firestore)
# Get these from: Firebase Console -> Project Settings -> General -> Your Apps -> Web App
# ------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------
# OPTION 2: MONGODB ATLAS (Backend API Database)
# Get this from: MongoDB Atlas -> Cluster -> Connect -> Connect your application -> URI
# ------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nera_db?retryWrites=true&w=majority
PORT=5000
